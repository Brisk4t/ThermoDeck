; ThermoDeck configuration -- lives at /config/thermodeck/thermodeck.ini on the device.

[spotify]
; From https://developer.spotify.com/dashboard -> your app -> Settings.
client_id = <YOUR_CLIENT_ID>
client_secret = <YOUR_CLIENT_SECRET>
; Must be listed under "Redirect URIs" in the app settings (exact match).
; With the default the browser on your phone/PC lands on a page that fails to load;
; paste that page's address into the ThermoDeck web page (http://<thermostat ip>:8080).
; If you can reach the thermostat over https, you can point this at
; https://<host>/callback instead and the code is picked up automatically.
redirect_uri = http://127.0.0.1:8080/callback
; How often to sync playback state while playing / while paused or idle.
poll_interval_ms = 2000
idle_poll_interval_ms = 5000
; Volume change per Vol +/- press (percent).
volume_step = 10

[homeassistant]
; Your Home Assistant address (use the IP: .local names don't resolve here) and a
; long-lived access token (HA: your profile > Security > Long-lived access tokens).
; https:// works too if HA has a publicly trusted certificate.
;url = http://192.168.1.10:8123
;token = <LONG_LIVED_ACCESS_TOKEN>
; URL of the dashboard to show, as in its address bar (Settings > Dashboards > Add
; dashboard named "ThermoDeck" gives dashboard-thermodeck). Build and edit it in HA;
; changes show up on the thermostat right away. Leave empty for the default dashboard.
; Layout: in a sections view each section is one screen of 12 columns x 8 rows (HA's
; grid rows; a heading takes about one of them); set the view to "max sections wide: 1" so HA's editor looks
; similar. Live preview of the screen: http://<thermostat ip>:8080/preview (e.g. in a
; Webpage card on another dashboard, next to the one you're editing).
;dashboard = dashboard-thermodeck
; Fallback if that dashboard doesn't exist: tiles for these entities.
;entities = light.living_room, switch.coffee_maker, sensor.outside_temperature

[display]
; Backlight 1-100
brightness = 80
; POSIX TZ string for the header clock, e.g. EST5EDT,M3.2.0,M11.1.0 or PST8PDT,M3.2.0,M11.1.0
timezone = UTC0
clock_24h = false

[touch]
device = /dev/input/event0
; Fix up orientation if taps land in the wrong place.
swap_xy = false
invert_x = false
invert_y = false
; 1 = log taps, 2 = log raw events (to /tmp/thermodeck.log)
debug = 0

[web]
port = 8080

[network]
ntp_server = pool.ntp.org
; Used only if DHCP didn't provide DNS servers.
fallback_dns = 1.1.1.1 8.8.8.8
